# Append after sdkconfig.defaults. Supply your private signing key in a private
# site defaults file; ESP32_P4_OTA_SECRETS_DIR locates TLS/admin credentials.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.ota.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_GW_OTA_ENABLED=y
CONFIG_GW_OTA_PORT=443
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secrets/firmware_signing_key.pem"
CONFIG_SECURE_INSECURE_ALLOW_DL_MODE=y
